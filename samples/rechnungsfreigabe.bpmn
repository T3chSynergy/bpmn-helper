          <dc:Bounds x="857" y="180" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Abgelehnt_di" bpmnElement="End_Abgelehnt">
