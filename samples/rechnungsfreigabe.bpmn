<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.org/bpmn-helper/sample">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Rechnungsfreigabe" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Rechnungsfreigabe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Buchhaltung" name="Buchhaltung">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reklamieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Abgelehnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zahlung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Bezahlt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Fachabteilung" name="Fachabteilung">
        <bpmn:flowNodeRef>Task_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Korrekt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Freigeben</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Rechnung eingegangen">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Erfassen" name="Rechnung erfassen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Pruefen" name="Rechnung sachlich prüfen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Korrekt" name="Rechnung korrekt?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Freigeben" name="Rechnung freigeben">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Reklamieren" name="Rechnung reklamieren">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Zahlung" name="Zahlung anweisen">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Bezahlt" name="Rechnung bezahlt">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Abgelehnt" name="Rechnung abgelehnt">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_Erfassen" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Erfassen" targetRef="Task_Pruefen" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Pruefen" targetRef="Gateway_Korrekt" />
    <bpmn:sequenceFlow id="Flow_4" name="ja" sourceRef="Gateway_Korrekt" targetRef="Task_Freigeben" />
    <bpmn:sequenceFlow id="Flow_5" name="nein" sourceRef="Gateway_Korrekt" targetRef="Task_Reklamieren" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Freigeben" targetRef="Task_Zahlung" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Zahlung" targetRef="End_Bezahlt" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Reklamieren" targetRef="End_Abgelehnt" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="60" width="860" height="380" />
