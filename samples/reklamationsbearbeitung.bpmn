<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Reklamation" targetNamespace="http://example.org/bpmn-helper/reklamationsbearbeitung">
  <bpmn:message id="Msg_Reklamation" name="Reklamation" />
  <bpmn:message id="Msg_Anforderung" name="Anforderung fehlender Angaben" />
  <bpmn:message id="Msg_Nachgereicht" name="Nachgereichte Angaben" />
  <bpmn:message id="Msg_Hinweis" name="Hinweis auf Unstimmigkeiten" />
  <bpmn:message id="Msg_Korrigiert" name="Korrigierte Angaben" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="P_Service" name="Kundenservice" processRef="Process_Reklamation" />
    <bpmn:participant id="P_Ext" name="Kunde/Kundin" />
    <bpmn:messageFlow id="MF1" name="Reklamation" sourceRef="P_Ext" targetRef="S1" />
    <bpmn:messageFlow id="MF2" name="Anforderung fehlender Angaben" sourceRef="A2" targetRef="P_Ext" />
    <bpmn:messageFlow id="MF3" name="Nachgereichte Angaben" sourceRef="P_Ext" targetRef="E1" />
    <bpmn:messageFlow id="MF4" name="Hinweis auf Unstimmigkeiten" sourceRef="A3" targetRef="P_Ext" />
    <bpmn:messageFlow id="MF5" name="Korrigierte Angaben" sourceRef="P_Ext" targetRef="E2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Reklamation" name="Reklamationsbearbeitung" isExecutable="false">
    <bpmn:startEvent id="S1" name="Reklamation eingegangen">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S1" messageRef="Msg_Reklamation" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G0">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A1" name="Reklamation auf Vollständigkeit und Plausibilität prüfen">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Angaben vollständig und plausibel?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="Fehlen Angaben?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="A2" name="Fehlende Angaben anfordern" messageRef="Msg_Anforderung">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="E1" name="Nachgereichte Angaben erhalten">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_E1" messageRef="Msg_Nachgereicht" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="A3" name="Kunde/Kundin auf Unstimmigkeiten hinweisen" messageRef="Msg_Hinweis">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="E2" name="Korrigierte Angaben erhalten">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_E2" messageRef="Msg_Korrigiert" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="A4" name="Reklamation inhaltlich prüfen">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="Reklamation berechtigt?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A5" name="Reklamation anerkennen und Gutschrift erstellen">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A6" name="Reklamation ablehnen und Ablehnungsschreiben erstellen">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Z1" name="Reklamation anerkannt">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Z2" name="Reklamation abgelehnt">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
